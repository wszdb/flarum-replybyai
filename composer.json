{
    "name": "wszdb/flarum-replybyai",
    "description": "AI-powered smart reply button for Flarum posts. Add intelligent AI-generated replies with one click.",
    "keywords": [
        "flarum",
        "ai",
        "reply",
        "assistant"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.2.0"
    },
    "authors": [
        {
            "name": "wszdb",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Wszdb\\FlarumReplyByAi\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Reply By AI",
            "category": "feature",
            "icon": {
                "name": "fas fa-robot",
                "color": "#4CAF50",
                "backgroundColor": "#E8F5E9"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": true,
                "css": true,
                "locale": true
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}